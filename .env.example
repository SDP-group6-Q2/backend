# --- Database ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=app

# --- Auth ---
JWT_SECRET=change-me
ACCESS_TOKEN_LIFETIME_SECONDS=3600

# --- First superuser (created by `python -m app.initial_data`) ---
FIRST_SUPERUSER_EMAIL=admin@example.com
FIRST_SUPERUSER_PASSWORD=change-me
FIRST_SUPERUSER_USERNAME=admin
FIRST_SUPERUSER_CLIENT_NAME=default

# --- Sample dataset seeding (`python -m app.seed_dataset`, also run by docker-entrypoint.sh) ---
# Whether the dataset's Users sheet is loaded too (development-only: see app/seed_dataset.py).
SEED_DATASET_USERS=true
DATASET_PATH=./data/AROL_Q2_synthetic_fleet_dataset.xlsx
# Read directly by docker-entrypoint.sh: skip seeding entirely, regardless of DATASET_PATH.
SEED_DATASET=true

# --- AI assistant (orchestrator service) ---
ORCHESTRATOR_URL=http://localhost:8001
ORCHESTRATOR_TIMEOUT_SECONDS=120

# --- Manuals storage (Supabase bucket, optional) ---
SUPABASE_URL=your_supabase_url
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
MANUALS_BUCKET=manuals
MANUAL_URL_TTL_SECONDS=60
